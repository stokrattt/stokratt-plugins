{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "mcp__.*__(addCommentToJiraIssue|addOrEditJiraIssueComment|createJiraIssue|editJiraIssue|createIssueLink|transitionJiraIssue|executeWrite|executeDestructive)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/qa-jira-write-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__.*__(addCommentToJiraIssue|addOrEditJiraIssueComment)",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/qa-draft-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Agent|Task",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/label-first-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "Skill",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/qa-skill-gate.mjs\"",
            "timeout": 10
          }
        ]
      },
      {
        "matcher": "mcp__playwright__.*",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/playwright-mcp-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/blocked-claim-gate.mjs\"",
            "timeout": 10
          },
          {
            "type": "command",
            "command": "node \"${CLAUDE_PLUGIN_ROOT}/hooks/orchestrator-stop-gate.mjs\"",
            "timeout": 10
          }
        ]
      }
    ]
  }
}
